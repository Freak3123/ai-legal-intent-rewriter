# MongoDB Atlas connection string
# Get this from Atlas → Clusters → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/legal-intent-rewriter?retryWrites=true&w=majority

# NextAuth (Auth.js v5)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-random-string-from-openssl
# In dev: http://localhost:3000  ·  In prod: your Vercel URL
NEXTAUTH_URL=http://localhost:3000

# FastAPI ML service URL
# Local dev: http://localhost:8000
# Prod: https://<team>-<space-name>.hf.space
ML_SERVICE_URL=http://localhost:8000

# Optional shared token for ML service auth (set the same value in apps/ml/.env)
# Leave blank in dev if you haven't enabled it on the ML side
ML_SERVICE_TOKEN=
