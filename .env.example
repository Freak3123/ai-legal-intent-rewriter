# Optional shared token. Set this AND set ML_SERVICE_TOKEN in apps/web/.env.local
# to require Bearer auth on /v1/analyze. Leave blank in dev for convenience.
ML_SERVICE_TOKEN=

# Hugging Face Hub token — only needed if you load private models from HF Hub.
# Get it at https://huggingface.co/settings/tokens
HF_TOKEN=

# Origins allowed by CORS — comma-separated, no spaces.
# In dev: http://localhost:3000
# In prod: your Vercel URL, e.g. https://legal-intent-rewriter.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
